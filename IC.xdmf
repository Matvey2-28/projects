<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="http://www.w3.org/2001/XInclude">
<Domain>
  <Grid GridType="Uniform" Name="PartType1">
    <Topology NumberOfElements="5000" TopologyType="PolyVertex" NodesPerElement="1"/>
    <Geometry GeometryType="XYZ">
      <DataItem Dimensions="5000 3" Format="HDF" Precision="8">IC.hdf5:/PartType1/Coordinates</DataItem>
    </Geometry>
    <Attribute Name="PartType1 Masses" AttributeType="Vector" Center="Node">
      <DataItem Dimensions="5000 1" Format="HDF" Precision="8">IC.hdf5:/PartType1/Masses</DataItem>
    </Attribute>
    <Attribute Name="PartType1 ParticleIDs" AttributeType="Vector" Center="Node">
      <DataItem Dimensions="5000 1" Format="HDF" Precision="8">IC.hdf5:/PartType1/ParticleIDs</DataItem>
    </Attribute>
    <Attribute Name="PartType1 Velocities" AttributeType="Vector" Center="Node">
      <DataItem Dimensions="5000 3" Format="HDF" Precision="8">IC.hdf5:/PartType1/Velocities</DataItem>
    </Attribute>
  </Grid>
</Domain>
</Xdmf>