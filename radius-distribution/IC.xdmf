<?xml version="1.0"?>
<!DOCTYPE Xdmf SYSTEM "Xdmf.dtd" []>
<Xdmf Version="3.0" xmlns:xi="http://www.w3.org/2001/XInclude">
<Domain>
  <Grid GridType="Uniform" Name="PartType0">
    <Topology NumberOfElements="23276" TopologyType="PolyVertex" NodesPerElement="1"/>
    <Geometry GeometryType="XYZ">
      <DataItem Dimensions="23276 3" Format="HDF" Precision="8">IC.hdf5:/PartType0/Coordinates</DataItem>
    </Geometry>
    <Attribute Name="PartType0 Density" AttributeType="Scalar" Center="Node">
      <DataItem Dimensions="23276 1" Format="HDF" Precision="8">IC.hdf5:/PartType0/Density</DataItem>
    </Attribute>
    <Attribute Name="PartType0 InternalEnergy" AttributeType="Scalar" Center="Node">
      <DataItem Dimensions="23276 1" Format="HDF" Precision="8">IC.hdf5:/PartType0/InternalEnergy</DataItem>
    </Attribute>
    <Attribute Name="PartType0 Masses" AttributeType="Scalar" Center="Node">
      <DataItem Dimensions="23276 1" Format="HDF" Precision="8">IC.hdf5:/PartType0/Masses</DataItem>
    </Attribute>
    <Attribute Name="PartType0 ParticleIDs" AttributeType="Scalar" Center="Node">
      <DataItem Dimensions="23276 1" Format="HDF" Precision="8">IC.hdf5:/PartType0/ParticleIDs</DataItem>
    </Attribute>
    <Attribute Name="PartType0 SmoothingLength" AttributeType="Scalar" Center="Node">
      <DataItem Dimensions="23276 1" Format="HDF" Precision="8">IC.hdf5:/PartType0/SmoothingLength</DataItem>
    </Attribute>
    <Attribute Name="PartType0 Velocities" AttributeType="Vector" Center="Node">
      <DataItem Dimensions="23276 3" Format="HDF" Precision="8">IC.hdf5:/PartType0/Velocities</DataItem>
    </Attribute>
  </Grid>
  <Grid GridType="Uniform" Name="PartType1">
    <Topology NumberOfElements="3" TopologyType="PolyVertex" NodesPerElement="1"/>
    <Geometry GeometryType="XYZ">
      <DataItem Dimensions="3 1" Format="HDF" Precision="8">IC.hdf5:/PartType1/Coordinates</DataItem>
    </Geometry>
    <Attribute Name="PartType1 Masses" AttributeType="Scalar" Center="Node">
      <DataItem Dimensions="1 1" Format="HDF" Precision="8">IC.hdf5:/PartType1/Masses</DataItem>
    </Attribute>
    <Attribute Name="PartType1 ParticleIDs" AttributeType="Scalar" Center="Node">
      <DataItem Dimensions="1 1" Format="HDF" Precision="8">IC.hdf5:/PartType1/ParticleIDs</DataItem>
    </Attribute>
    <Attribute Name="PartType1 Velocities" AttributeType="Scalar" Center="Node">
      <DataItem Dimensions="3 1" Format="HDF" Precision="8">IC.hdf5:/PartType1/Velocities</DataItem>
    </Attribute>
  </Grid>
</Domain>
</Xdmf>